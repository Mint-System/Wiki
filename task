#!/usr/bin/env bash
set -e

if [[ -f ".env" ]]; then
    # shellcheck source=/dev/null
    source ".env"
fi

help-table() {
    local -a rows
    local max_cmd=7 max_opt=6 max_desc=11

    rows+=("Command|Option|Description")
    rows+=("init-zensical-docs||Initialize Zensical project.")
    rows+=("prepare-docs||Convert markdown wiki files to docs.")
    rows+=("dev-zensical-docs||Start Zensical development server.")
    rows+=("build-zensical-docs||Create Zensical build.")
    rows+=("serve-zensical-docs||Serve Zensical build.")
    rows+=("convert-files||Convert markdown wiki links to normal link.")
    rows+=("convert-canvas||Convert canvas files to svg.")
    rows+=("generate-bases-views||Generate markdown tables from bases.")
    rows+=("delete-bases-views||Delete bases markdown files.")
    rows+=("review-notes||Open a random note reviewed note.")

    for row in "${rows[@]}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        (( ${#cmd} > max_cmd )) && max_cmd=${#cmd}
        (( ${#opt} > max_opt )) && max_opt=${#opt}
        (( ${#desc} > max_desc )) && max_desc=${#desc}
    done

    printf '| %-*s | %-*s | %-*s |\n' \
        "$max_cmd" "Command" \
        "$max_opt" "Option" \
        "$max_desc" "Description"

    printf '|-%*s-|-%*s-|-%*s-|\n' \
        "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
        "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
        "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"

    local first_row=true
    for row in "${rows[@]:1}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        if [[ "$cmd" =~ ^===.*===$ ]]; then
            group_name="${cmd/===/}"
            group_name="${group_name/===/}"
            
            if [ "$first_row" = true ]; then
                first_row=false
            else
                printf '|-%*s-|-%*s-|-%*s-|\n' \
                    "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
                    "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
                    "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"
            fi
            
            local left_pad=$(( (max_cmd - ${#group_name}) / 2 ))
            local right_pad=$(( max_cmd - left_pad - ${#group_name} ))
            printf '| %*s%s%*s | %*s | %*s |\n' \
                "$left_pad" "" \
                "$group_name" \
                "$right_pad" "" \
                "$max_opt" "" \
                "$max_desc" ""
            
            printf '|-%*s-|-%*s-|-%*s-|\n' \
                "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
                "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
                "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"
        else
            first_row=false
            printf '| %-*s | %-*s | %-*s |\n' \
                "$max_cmd" "$cmd" \
                "$max_opt" "$opt" \
                "$max_desc" "$desc"
        fi
    done
}

help() {
    local grep_pattern
    echo
    if [[ -n "$1" ]]; then
        grep_pattern="$1"
        help-table | grep -i "$grep_pattern" | column -t -s'|'
    else
        echo "task <command> [options]"
        echo
        echo "commands:"
        echo
        help-table
    fi
    echo
}

if [ -d "$HOME/taskfile.build/bin" ]; then
    for file in "$HOME/taskfile.build/bin/"*; do
        if [ -f "$file" ]; then
            source "$file"
        fi
    done
fi

function review-notes() {
    VAULT_PATH="$(pwd)"
    REVIEW_LOG="$VAULT_PATH/review-note.csv"

    if [[ ! -f "$REVIEW_LOG" ]]; then
        echo "Init review log."
        echo "note_name,timestamp" > "$REVIEW_LOG"
    fi

    echo "Get reviewed files."
    REVIEWED_FILES=$(cut -d',' -f1 "$REVIEW_LOG" | tail -n +2)

    echo "Find all markdown files."
    # Explicitly exclude generated/vendor directories. Relying on git check-ignore
    # is unreliable here: docs/ contains tracked files (docs/javascripts/extra.js
    # etc.), so git would not report it as ignored and generated notes would be
    # opened for review instead of the source notes.
    MD_FILES=$(find . -type f -name "*.md" \
        -not -path "./docs/*" \
        -not -path "./site/*" \
        -not -path "./node_modules/*" \
        -not -path "./.venv/*" \
        -not -path "./.git/*")

    echo "Filter unreviewed files."
    UNREVIEWED_FILES=$(echo "$MD_FILES")

    if [[ -z "$UNREVIEWED_FILES" ]]; then
        echo "No new files to review!"
        return
    fi

    echo "Pick a random file."
    SELECTED_FILE=$(echo "$UNREVIEWED_FILES" | shuf -n 1)

    NOTE_NAME=$(basename "$SELECTED_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

    ENCODED_FILE=$(echo -n "$NOTE_NAME" | jq -sRr @uri)
    echo "Encode '$NOTE_NAME' to '$ENCODED_FILE'"
    echo "Opening obsidian://open?vault=$(basename "$PWD")&file=$ENCODED_FILE"
    obsidian "obsidian://open?vault=$(basename "$PWD")&file=$ENCODED_FILE" &

    echo "Log the review."
    echo "\"$NOTE_NAME\",\"$TIMESTAMP\"" >> "$REVIEW_LOG"
}

function prepare-docs() {
    if [ ! -d "node_modules" ]; then
        echo "Installing pnpm dependencies..."
        pnpm install
    fi
    node bin/build.js all
}

function generate-bases-views() {
    node bin/generate-bases-views.js
}

function delete-bases-views() {
    node bin/delete-bases-views.js
}

function convert-files() {
    node bin/build.js index
    node bin/build.js convert
    node bin/build.js attachments
}

function convert-canvas() {
    node bin/build.js canvas
}

if [[ "$1" == *","* ]]; then
    # Split comma-separated commands
    IFS=',' read -ra COMMANDS <<< "$1"
    for cmd in "${COMMANDS[@]}"; do
        # Trim whitespace
        cmd=$(echo "$cmd" | xargs)
        if declare -f "$cmd" > /dev/null; then
            "$cmd"
        else
            echo "Unknown command: $cmd"
            help "$@"
            exit 1
        fi
    done
elif declare -f "$1" > /dev/null; then
    if [[ "${2:-}" == "tfhelp" ]]; then
        help "$1"
    else
        "$1" "${@:2}"
    fi
else
    case "$1" in
        *)
            echo "Unknown command: $1"
            exit 1
            ;;
    esac
fi
