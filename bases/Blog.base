views:
  - type: table
    name: Table
    filters:
      and:
        - section == "blog"
    groupBy:
      property: draft
      direction: ASC
    order:
      - file.name
      - kind
      - section
      - draft
      - title
    sort:
      - property: title
        direction: ASC
    columnSize:
      file.name: 610
